{
  "id": "a1b2c3d4-pr14-4000-8000-000000000014",
  "version": "2.0",
  "name": "PR14 Registration and Cart",
  "url": "https://www.saucedemo.com",
  "tests": [
    {
      "id": "t14-login-ok",
      "name": "Login success",
      "commands": [
        { "id": "c14-l1", "comment": "", "command": "open", "target": "https://www.saucedemo.com/", "targets": [], "value": "" },
        { "id": "c14-l2", "comment": "", "command": "assertTitle", "target": "Swag Labs", "targets": [], "value": "" },
        { "id": "c14-l3", "comment": "", "command": "type", "target": "id=user-name", "targets": [], "value": "standard_user" },
        { "id": "c14-l4", "comment": "", "command": "type", "target": "id=password", "targets": [], "value": "secret_sauce" },
        { "id": "c14-l5", "comment": "", "command": "click", "target": "id=login-button", "targets": [], "value": "" },
        { "id": "c14-l6", "comment": "", "command": "waitForElementPresent", "target": "css=.inventory_list", "targets": [], "value": "10000" },
        { "id": "c14-l7", "comment": "", "command": "assertElementPresent", "target": "css=.inventory_list", "targets": [], "value": "" },
        { "id": "c14-l8", "comment": "", "command": "assertText", "target": "css=.title", "targets": [], "value": "Products" }
      ]
    },
    {
      "id": "t14-login-fail",
      "name": "Login locked user",
      "commands": [
        { "id": "c14-f1", "comment": "", "command": "open", "target": "https://www.saucedemo.com/", "targets": [], "value": "" },
        { "id": "c14-f2", "comment": "", "command": "type", "target": "id=user-name", "targets": [], "value": "locked_out_user" },
        { "id": "c14-f3", "comment": "", "command": "type", "target": "id=password", "targets": [], "value": "secret_sauce" },
        { "id": "c14-f4", "comment": "", "command": "click", "target": "id=login-button", "targets": [], "value": "" },
        { "id": "c14-f5", "comment": "", "command": "waitForElementPresent", "target": "css=[data-test=\"error\"]", "targets": [], "value": "5000" },
        { "id": "c14-f6", "comment": "", "command": "assertElementPresent", "target": "css=[data-test=\"error\"]", "targets": [], "value": "" }
      ]
    },
    {
      "id": "t14-short-login",
      "name": "Short password",
      "commands": [
        { "id": "c14-sp1", "comment": "", "command": "open", "target": "https://www.saucedemo.com/", "targets": [], "value": "" },
        { "id": "c14-sp2", "comment": "", "command": "type", "target": "id=user-name", "targets": [], "value": "standard_user" },
        { "id": "c14-sp3", "comment": "", "command": "type", "target": "id=password", "targets": [], "value": "12345" },
        { "id": "c14-sp4", "comment": "", "command": "click", "target": "id=login-button", "targets": [], "value": "" },
        { "id": "c14-sp5", "comment": "", "command": "waitForElementVisible", "target": "css=[data-test=\"error\"]", "targets": [], "value": "8000" },
        { "id": "c14-sp6", "comment": "", "command": "assertElementPresent", "target": "css=[data-test=\"error\"]", "targets": [], "value": "" },
        { "id": "c14-sp7", "comment": "", "command": "assertText", "target": "css=[data-test=\"error\"]", "targets": [], "value": "*Username and password*" }
      ]
    },
    {
      "id": "t14-cart",
      "name": "Add product to cart",
      "commands": [
        { "id": "c14-c1", "comment": "", "command": "open", "target": "https://www.saucedemo.com/", "targets": [], "value": "" },
        { "id": "c14-c2", "comment": "", "command": "type", "target": "id=user-name", "targets": [], "value": "standard_user" },
        { "id": "c14-c3", "comment": "", "command": "type", "target": "id=password", "targets": [], "value": "secret_sauce" },
        { "id": "c14-c4", "comment": "", "command": "click", "target": "id=login-button", "targets": [], "value": "" },
        { "id": "c14-c5", "comment": "", "command": "waitForElementPresent", "target": "css=.inventory_list", "targets": [], "value": "10000" },
        { "id": "c14-c6", "comment": "", "command": "click", "target": "id=add-to-cart-sauce-labs-backpack", "targets": [], "value": "" },
        { "id": "c14-c7", "comment": "", "command": "click", "target": "css=.shopping_cart_link", "targets": [], "value": "" },
        { "id": "c14-c8", "comment": "", "command": "waitForElementPresent", "target": "css=.cart_item", "targets": [], "value": "5000" },
        { "id": "c14-c9", "comment": "", "command": "assertElementPresent", "target": "css=.cart_item", "targets": [], "value": "" },
        { "id": "c14-c10", "comment": "", "command": "assertText", "target": "css=.inventory_item_name", "targets": [], "value": "Sauce Labs Backpack" }
      ]
    },
    {
      "id": "t14-reg",
      "name": "Registration success",
      "commands": [
        { "id": "c14-r1", "comment": "", "command": "executeScript", "target": "return 'pr14' + Date.now() + '@example.com'", "targets": [], "value": "email" },
        { "id": "c14-r2", "comment": "", "command": "open", "target": "https://automationexercise.com/login", "targets": [], "value": "" },
        { "id": "c14-r3", "comment": "", "command": "assertTitle", "target": "*Automation Exercise*", "targets": [], "value": "" },
        { "id": "c14-r4", "comment": "", "command": "type", "target": "css=input[data-qa='signup-name']", "targets": [], "value": "Ivan Petrov" },
        { "id": "c14-r5", "comment": "", "command": "type", "target": "css=input[data-qa='signup-email']", "targets": [], "value": "${email}" },
        { "id": "c14-r6", "comment": "", "command": "click", "target": "css=button[data-qa='signup-button']", "targets": [], "value": "" },
        { "id": "c14-r7", "comment": "", "command": "waitForElementVisible", "target": "id=password", "targets": [], "value": "15000" },
        { "id": "c14-r8", "comment": "", "command": "click", "target": "id=id_gender1", "targets": [], "value": "" },
        { "id": "c14-r9", "comment": "", "command": "type", "target": "id=password", "targets": [], "value": "Password123" },
        { "id": "c14-r10", "comment": "", "command": "type", "target": "id=first_name", "targets": [], "value": "Ivan" },
        { "id": "c14-r11", "comment": "", "command": "type", "target": "id=last_name", "targets": [], "value": "Petrov" },
        { "id": "c14-r12", "comment": "", "command": "type", "target": "id=address1", "targets": [], "value": "Street 1" },
        { "id": "c14-r13", "comment": "", "command": "executeScript", "target": "var s=document.querySelector('#country'); s.value='India'; s.dispatchEvent(new Event('change')); return s.value;", "targets": [], "value": "country" },
        { "id": "c14-r14", "comment": "", "command": "type", "target": "id=state", "targets": [], "value": "Maharashtra" },
        { "id": "c14-r15", "comment": "", "command": "type", "target": "id=city", "targets": [], "value": "Mumbai" },
        { "id": "c14-r16", "comment": "", "command": "type", "target": "id=zipcode", "targets": [], "value": "400001" },
        { "id": "c14-r17", "comment": "", "command": "type", "target": "id=mobile_number", "targets": [], "value": "9000000000" },
        { "id": "c14-r18", "comment": "", "command": "click", "target": "css=button[data-qa='create-account']", "targets": [], "value": "" },
        { "id": "c14-r19", "comment": "", "command": "waitForText", "target": "css=h2[data-qa='account-created']", "targets": [], "value": "*ACCOUNT CREATED*" },
        { "id": "c14-r20", "comment": "", "command": "assertText", "target": "css=h2[data-qa='account-created']", "targets": [], "value": "*ACCOUNT CREATED*" },
        { "id": "c14-r21", "comment": "", "command": "click", "target": "css=a[data-qa='continue-button']", "targets": [], "value": "" },
        { "id": "c14-r22", "comment": "", "command": "click", "target": "css=a[href='/logout']", "targets": [], "value": "" },
        { "id": "c14-r23", "comment": "", "command": "waitForElementVisible", "target": "css=input[data-qa='signup-email']", "targets": [], "value": "15000" },
        { "id": "c14-r24", "comment": "", "command": "type", "target": "css=input[data-qa='signup-name']", "targets": [], "value": "Ivan Petrov" },
        { "id": "c14-r25", "comment": "", "command": "type", "target": "css=input[data-qa='signup-email']", "targets": [], "value": "${email}" },
        { "id": "c14-r26", "comment": "", "command": "click", "target": "css=button[data-qa='signup-button']", "targets": [], "value": "" },
        { "id": "c14-r27", "comment": "", "command": "waitForText", "target": "css=.signup-form p", "targets": [], "value": "*already exist*" },
        { "id": "c14-r28", "comment": "", "command": "assertText", "target": "css=.signup-form p", "targets": [], "value": "*already exist*" }
      ]
    }
  ],
  "suites": [
    {
      "id": "s14-001",
      "name": "All scenarios",
      "persistSession": false,
      "parallel": false,
      "timeout": 300,
      "tests": ["t14-login-ok", "t14-login-fail", "t14-short-login", "t14-cart", "t14-reg"]
    }
  ],
  "urls": ["https://www.saucedemo.com", "https://automationexercise.com"],
  "plugins": []
}
